            end
            local olhar = CFrame.lookAt(rootPart.Position, posAlvo)
            rootPart.CFrame = CFrame.new(rootPart.Position, olhar.LookVector + rootPart.Position)
            pcall(function()
                espada:Activate()
                wait(0.05)
                espada:Activate()
                usarPoderes()
            end)
            killsNPC = killsNPC + 1
            killsNPCLabel.Text = "🧟 " .. killsNPC
        end
    else
        alvoNPC = nil
    end
end

function alternarKillNPC()
    if not vivo() then return end
    matandoNPC = not matandoNPC
    if matandoNPC then
        espada = acharEspada()
        if not espada then matandoNPC = false return end
        btnKillNPC.Text = "⏹ PARAR"
        btnKillNPC.BackgroundColor3 = Color3.fromRGB(200, 100, 100)
        alvoNPC = nil
        if loopKillNPC then loopKillNPC:Disconnect() end
        loopKillNPC = RunService.Heartbeat:Connect(function()
            if matandoNPC then loopKillNPCFunc() wait(0.05) end
        end)
    else
        btnKillNPC.Text = "🧟 NPC KILL"
        btnKillNPC.BackgroundColor3 = Color3.fromRGB(100, 200, 100)
        alvoNPC = nil
        if loopKillNPC then loopKillNPC:Disconnect() loopKillNPC = nil end
    end
end


    matandoBoss = not matandoBoss
    if matandoBoss then
        espada = acharEspada()
        if not espada then matandoBoss = false return end
        btnKillBoss.Text = "⏹ PARAR"
        btnKillBoss.BackgroundColor3 = Color3.fromRGB(200, 150, 0)
        alvoBoss = nil
        if loopKillBoss then loopKillBoss:Disconnect() end
        loopKillBoss = RunService.Heartbeat:Connect(function()
            if matandoBoss then loopKillBossFunc() wait(0.05) end

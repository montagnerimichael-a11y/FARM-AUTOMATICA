-- ===== CACHE =====
local cacheObjetos = {}
local ultimaAtualizacaoCache = 0

local function atualizarCache()
    local agora = tick()
    if agora - ultimaAtualizacaoCache > 1.5 then
        cacheObjetos = workspace:GetDescendants()
        ultimaAtualizacaoCache = agora
        return true
    end
    return false
end

-- ============================================
-- FUNÇÕES AUXILIARES
-- ============================================

function vivo()
    return character and character.Parent and humanoid and humanoid.Health > 0
end

function classificarObjeto(nome)
    nome = nome:lower()
    if nome:find("diamond") or nome:find("diamante") or nome:find("gem") then
        return "diamante"
    end
    return nil
end

function acharEspada()
    if character then
        for _, obj in pairs(character:GetChildren()) do
            if obj:IsA("Tool") then
                local nome = obj.Name:lower()
                if nome:find("sword") or nome:find("espada") or nome:find("katana") or nome:find("blade") or nome:find("arma") then
                    return obj
                end
            end
        end
    end
    return nil
end

function acharEspadaLava()
    if character then
        for _, obj in pairs(character:GetChildren()) do
            if obj:IsA("Tool") then
                local nome = obj.Name:lower()
                if nome:find("lava") then
                    espadaLava = obj
                    return espadaLava
                end
            end
        end
    end
    return nil
end

function acharAlvo()
    if not vivo() then return nil end
    local pos = rootPart.Position
    local melhor = nil
    local menorDistancia = raio + 50
    for _, jogador in pairs(Players:GetPlayers()) do
        if jogador ~= player then
            local c = jogador.Character
            if c and c:FindFirstChild("Humanoid") and c.Humanoid.Health > 0 then
                local hrp = c:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local d = (hrp.Position - pos).Magnitude
                    if d < menorDistancia then
                        menorDistancia = d
                        melhor = jogador
                    end
                end
            end
        end
    end
    return melhor
end

function acharNPC()
    if not vivo() then return nil end
    local pos = rootPart.Position
    local melhor = nil
    local menorDistancia = raio + 50
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("Model") then
            local hum = obj:FindFirstChild("Humanoid")
            if hum and hum.Health > 0 then
                local isPlayer = false
                for _, p in pairs(Players:GetPlayers()) do
                    if p.Character == obj then
                        isPlayer = true
                        break
                    end
                end
                if not isPlayer then
                    local hrp = obj:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        local d = (hrp.Position - pos).Magnitude
                        if d < menorDistancia then
                            menorDistancia = d
                            melhor = obj
                        end
                    end
                end
            end
        end
    end
    return melhor
end

function usarPoderes()
    local teclas = {"Z", "X", "C", "V", "B", "F", "G"}
    for _, tecla in ipairs(teclas) do
        pcall(function()
            VirtualInputManager:SendKeyEvent(true, tecla, false, game)
            wait(0.03)
            VirtualInputManager:SendKeyEvent(false, tecla, false, game)
        end)
    end
end

function carregarVulcao()
    if cargaVulcao < cargaMaxima then
        cargaVulcao = cargaVulcao + 1
        if cargaVulcao >= cargaMaxima then
            print("🌋 Vulcão CARREGADO!")
        end
    end
    if vulcaoLabel then
        vulcaoLabel.Text = "🌋 " .. cargaVulcao .. "/" .. cargaMaxima
        vulcaoLabel.TextColor3 = (cargaVulcao >= cargaMaxima) and Color3.fromRGB(255, 200, 0) or Color3.fromRGB(255, 255, 255)
    end
end

-- ============================================
-- ANTI-AFK
-- ============================================

local function antiAFKFunc()
    if not antiAFKAtivo or not vivo() then return end
    print("🛡️ Anti-AFK #" .. afkContador)
    pcall(function()
        humanoid.Jump = true
        wait(0.1)
        humanoid.Jump = false
    end)
    afkContador = afkContador + 1
end

local function alternarAntiAFK()
    antiAFKAtivo = not antiAFKAtivo
    if antiAFKAtivo then
        btnAntiAFK.Text = "🛡️ ANTI-AFK: ON"
        btnAntiAFK.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
        antiAFKFunc()
        ultimoMovimento = tick()
        if loopAntiAFK then loopAntiAFK:Disconnect() end
        loopAntiAFK = RunService.Heartbeat:Connect(function()
            if tick() - ultimoMovimento > math.random(40, 80) then
                antiAFKFunc()
                ultimoMovimento = tick()
            end
        end)
        print("🛡️ Anti-AFK ATIVADO!")
    else
        btnAntiAFK.Text = "🛡️ ANTI-AFK: OFF"
        btnAntiAFK.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
        if loopAntiAFK then loopAntiAFK:Disconnect() loopAntiAFK = nil end
        print("🛡️ Anti-AFK DESATIVADO!")
    end
end

-- ============================================
-- VELOCIDADE
-- ============================================

local function definirVelocidade(novaVelocidade)
    velocidadeAtual = math.clamp(novaVelocidade, velocidadeMinima, velocidadeMaxima)
    if humanoid then humanoid.WalkSpeed = velocidadeAtual end
    if velocidadeAtual > 16 then
        if loopVelocidade then loopVelocidade:Disconnect() end
        loopVelocidade = RunService.Heartbeat:Connect(function()
            if humanoid and humanoid.Health > 0 and humanoid.WalkSpeed ~= velocidadeAtual then
                humanoid.WalkSpeed = velocidadeAtual
            end
        end)
    else
        if loopVelocidade then loopVelocidade:Disconnect() loopVelocidade = nil end
        if humanoid then humanoid.WalkSpeed = 16 end
    end
end

-- ============================================
-- FLY
-- ============================================

local function iniciarFly()
    if flyAtivo or not character or not rootPart then return end
    flyAtivo = true
    print("🕊️ Fly ativado!")

    flyBodyVelocity = Instance.new("BodyVelocity")
    flyBodyVelocity.MaxForce = Vector3.new(1e6, 1e6, 1e6)
    flyBodyVelocity.Velocity = Vector3.new(0, 0, 0)
    flyBodyVelocity.Parent = rootPart

    flyBodyGyro = Instance.new("BodyGyro")
    flyBodyGyro.MaxTorque = Vector3.new(1e6, 1e6, 1e6)
    flyBodyGyro.CFrame = rootPart.CFrame
    flyBodyGyro.Parent = rootPart

    if loopFly then loopFly:Disconnect() end
    loopFly = RunService.Heartbeat:Connect(function()
        if not flyAtivo or not rootPart then return end
        local moveDirection = Vector3.new(0, 0, 0)
        local camera = workspace.CurrentCamera
        if camera then
            local forward = camera.CFrame.LookVector
            local right = camera.CFrame.RightVector
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDirection = moveDirection + Vector3.new(forward.X, 0, forward.Z).Unit end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDirection = moveDirection - Vector3.new(forward.X, 0, forward.Z).Unit end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDirection = moveDirection - Vector3.new(right.X, 0, right.Z).Unit end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDirection = moveDirection + Vector3.new(right.X, 0, right.Z).Unit end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveDirection = moveDirection + Vector3.new(0, 1, 0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then moveDirection = moveDirection + Vector3.new(0, -1, 0) end
        end
        if moveDirection.Magnitude > 0 then
            flyBodyVelocity.Velocity = moveDirection.Unit * flySpeed
        else
            flyBodyVelocity.Velocity = Vector3.new(0, 0, 0)
        end
        flyBodyGyro.CFrame = CFrame.new(rootPart.Position, rootPart.Position + Vector3.new(0, -1, 0))
    end)
end

local function pararFly()
    if not flyAtivo then return end
    flyAtivo = false
    print("🕊️ Fly desativado!")
    if flyBodyVelocity then flyBodyVelocity:Destroy() flyBodyVelocity = nil end
    if flyBodyGyro then flyBodyGyro:Destroy() flyBodyGyro = nil end
    if loopFly then loopFly:Disconnect() loopFly = nil end
end

-- ============================================
-- HITBOX + AURA
-- ============================================

local function criarAuraInimigo(alvo)
    if not alvo or not alvo.Character then return end
    local hrp = alvo.Character:FindFirstChild("HumanoidRootPart")
    if not hrp or auras[alvo] then return end

    local aura = Instance.new("Part")
    aura.Size = Vector3.new(hitboxRaio * 2, 0.3, hitboxRaio * 2)
    aura.Position = hrp.Position
    aura.Anchored = true
    aura.CanCollide = false
    aura.Transparency = 0.75
    aura.BrickColor = BrickColor.new("Bright red")
    aura.Material = Enum.Material.Neon
    aura.Parent = workspace
    auras[alvo] = aura

    local conn
    conn = RunService.Heartbeat:Connect(function()
        if not alvo or not alvo.Character or not alvo.Character:FindFirstChild("HumanoidRootPart") then
            if aura then aura:Destroy() end
            auras[alvo] = nil
            if conn then conn:Disconnect() end
            return
        end
        local hrp2 = alvo.Character:FindFirstChild("HumanoidRootPart")
        if hrp2 and aura then aura.Position = hrp2.Position end
    end)
end

local function removerAuras()
    for _, aura in pairs(auras) do pcall(function() aura:Destroy() end) end
    auras = {}
end

local function ativarHitbox()
    if hitboxExpandido then return end
    hitboxExpandido = true
    print("🎯 Hitbox ativado!")

    if loopHitbox then loopHitbox:Disconnect() end
    loopHitbox = RunService.Heartbeat:Connect(function()
        if not hitboxExpandido then return end
        local alvos = {}
        for _, jogador in pairs(Players:GetPlayers()) do
            if jogador ~= player then
                local c = jogador.Character
                if c and c:FindFirstChild("Humanoid") and c.Humanoid.Health > 0 then
                    table.insert(alvos, jogador)
                end
            end
        end
        for _, alvo in pairs(alvos) do
            if not auras[alvo] then criarAuraInimigo(alvo) end
        end
        for alvo, aura in pairs(auras) do
            local stillAlive = false
            for _, a in pairs(alvos) do
                if a == alvo then stillAlive = true break end
            end
            if not stillAlive then
                pcall(function() aura:Destroy() end)
                auras[alvo] = nil
            end
        end
    end)
end

local function desativarHitbox()
    if not hitboxExpandido then return end
    hitboxExpandido = false
    if loopHitbox then loopHitbox:Disconnect() loopHitbox = nil end
    removerAuras()
    print("🎯 Hitbox desativado!")
end

-- ============================================
-- COLETA (DIAMANTES)
-- ============================================

function coletarDiamantes()
    if not vivo() then return end
    local pos = rootPart.Position
    local count = 0
    for _, obj in pairs(cacheObjetos) do
        if obj:IsA("BasePart") and classificarObjeto(obj.Name) == "diamante" then
            local dist = (obj.Position - pos).Magnitude
            if dist < raio then
                pcall(function()
                    obj.CFrame = rootPart.CFrame + Vector3.new(0, 1.5, 0)
                    Debris:AddItem(obj, 0.1)
                    count = count + 1
                end)
            end
        end
    end
    if count > 0 then
        diamantes = diamantes + count
        contador.Text = "💎" .. diamantes .. " ⚔️" .. kills
    end
end

function alternarColeta()
    if not vivo() then return end
    coletando = not coletando
    if coletando then
        btnColeta.Text = "⏹ PARAR"
        btnColeta.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        if loopColeta then loopColeta:Disconnect() end
        loopColeta = RunService.Heartbeat:Connect(function()
            if coletando and vivo() then
                if atualizarCache() then coletarDiamantes() end
            end
        end)
    else
        btnColeta.Text = "💎 COLETA"
        btnColeta.BackgroundColor3 = Color3.fromRGB(0, 150, 255)
        if loopColeta then loopColeta:Disconnect() loopColeta = nil end
    end
end

-- ============================================
-- KILL NORMAL
-- ============================================

function loopKillFunc()
    if not matando then return end
    if not vivo() then
        matando = false
        btnKill.Text = "⚔️ KILL"
        btnKill.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        if loopKill then loopKill:Disconnect() loopKill = nil end
        return
    end
    if not espada or not espada.Parent then
        espada = acharEspada()
        if not espada then wait(2) return end
    end
    if not alvo or not alvo.Character or alvo.Character.Humanoid.Health <= 0 then
        alvo = acharAlvo()
        if not alvo then wait(1) return end
    end
    if alvo and alvo.Character and alvo.Character.Humanoid.Health > 0 then
        local hrp = alvo.Character:FindFirstChild("HumanoidRootPart")
        if hrp then
            local posAlvo = hrp.Position
            local dist = (posAlvo - rootPart.Position).Magnitude
            local cf = hrp.CFrame
            local costas = cf.LookVector * -1
            local posCostas = posAlvo + (costas * 2.5)

            if dist > 15 then
                local dir = (posCostas - rootPart.Position).Unit
                rootPart.CFrame = rootPart.CFrame + (dir * 10)
                return
            end
            local olhar = CFrame.lookAt(rootPart.Position, posAlvo)
            rootPart.CFrame = CFrame.new(rootPart.Position, olhar.LookVector + rootPart.Position)
            pcall(function()
                espada:Activate()
                wait(0.05)
                espada:Activate()
                usarPoderes()
            end)
            kills = kills + 1
            contador.Text = "💎" .. diamantes .. " ⚔️" .. kills
        end
    end
end

function alternarKill()
    if not vivo() then return end
    matando = not matando
    if matando then
        espada = acharEspada()
        if not espada then matando = false return end
        btnKill.Text = "⏹ PARAR"
        btnKill.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
        if loopKill then loopKill:Disconnect() end
        loopKill = RunService.Heartbeat:Connect(function()
            if matando then loopKillFunc() wait(0.05) end
        end)
    else
        btnKill.Text = "⚔️ KILL"
        btnKill.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        alvo = nil
        if loopKill then loopKill:Disconnect() loopKill = nil end
    end
end

-- ============================================
-- KILL LAVA
-- ============================================

function loopKillLavaFunc()
    if not matandoLava then return end
    if not vivo() then
        matandoLava = false
        btnKillLava.Text = "🌋 KILL LAVA"
        btnKillLava.BackgroundColor3 = Color3.fromRGB(255, 100, 0)
        if loopKillLava then loopKillLava:Disconnect() loopKillLava = nil end
        return
    end
    if not espadaLava or not espadaLava.Parent then
        acharEspadaLava()
        if not espadaLava then wait(2) return end
    end
    if not alvoLava or not alvoLava.Character or alvoLava.Character.Humanoid.Health <= 0 then
        alvoLava = acharAlvo()
        if not alvoLava then wait(1) return end
    end
    if alvoLava and alvoLava.Character and alvoLava.Character.Humanoid.Health > 0 then
        local hrp = alvoLava.Character:FindFirstChild("HumanoidRootPart")
        if hrp then
            local posAlvo = hrp.Position
            local dist = (posAlvo - rootPart.Position).Magnitude
            local cf = hrp.CFrame
            local costas = cf.LookVector * -1
            local posCostas = posAlvo + (costas * 2.5)

            if dist > 15 then
                local dir = (posCostas - rootPart.Position).Unit
                rootPart.CFrame = rootPart.CFrame + (dir * 10)
                return
            end
            local olhar = CFrame.lookAt(rootPart.Position, posAlvo)
            rootPart.CFrame = CFrame.new(rootPart.Position, olhar.LookVector + rootPart.Position)

            pcall(function()
                espadaLava:Activate()
                wait(0.05)
                espadaLava:Activate()
                carregarVulcao()

                local agora = tick()

                if cargaVulcao >= cargaMaxima and agora - ultimoUsoVulcao > tempoCooldownVulcao then
                    pcall(function()
                        VirtualInputManager:SendKeyEvent(true, "Q", false, game)
                        wait(0.1)
                        VirtualInputManager:SendKeyEvent(false, "Q", false, game)
                        cargaVulcao = 0
                        ultimoUsoVulcao = agora
                    end)
                end

                if agora - ultimoUsoExplosao > tempoCooldownExplosao then
                    pcall(function()
                        VirtualInputManager:SendKeyEvent(true, "2", false, game)
                        wait(0.1)
                        VirtualInputManager:SendKeyEvent(false, "2", false, game)
                        ultimoUsoExplosao = agora
                    end)
                end

                if agora - ultimoUsoForma > tempoCooldownForma then
                    pcall(function()
                        VirtualInputManager:SendKeyEvent(true, "3", false, game)
                        wait(0.1)
                        VirtualInputManager:SendKeyEvent(false, "3", false, game)
                        ultimoUsoForma = agora
                    end)
                end
            end)

            killsLava = killsLava + 1
            killsLavaLabel.Text = "🌋 " .. killsLava
        end
    end
end

function alternarKillLava()
    if not vivo() then return end
    matandoLava = not matandoLava
    if matandoLava then
        acharEspadaLava()
        if not espadaLava then matandoLava = false return end
        btnKillLava.Text = "⏹ PARAR"
        btnKillLava.BackgroundColor3 = Color3.fromRGB(200, 100, 0)
        ultimoUsoVulcao = 0
        ultimoUsoExplosao = 0
        ultimoUsoForma = 0
        cargaVulcao = 0
        if loopKillLava then loopKillLava:Disconnect() end
        loopKillLava = RunService.Heartbeat:Connect(function()
            if matandoLava then loopKillLavaFunc() wait(0.05) end
        end)
    else
        btnKillLava.Text = "🌋 KILL LAVA"
        btnKillLava.BackgroundColor3 = Color3.fromRGB(255, 100, 0)
        alvoLava = nil
        if loopKillLava then loopKillLava:Disconnect() loopKillLava = nil end
    end
end


function loopKillBossFunc()
    if not matandoBoss then return end
    if not vivo() then
        matandoBoss = false
        btnKillBoss.Text = "👑 BOSS KILL"
        btnKillBoss.BackgroundColor3 = Color3.fromRGB(255, 215, 0)
        if loopKillBoss then loopKillBoss:Disconnect() loopKillBoss = nil end
        return
    end
    if not espada or not espada.Parent then
        espada = acharEspada()
        if not espada then wait(2) return end
    end
    if not alvoBoss then
        alvoBoss = acharNPC()
        if not alvoBoss then wait(2) return end
    end
    if alvoBoss and alvoBoss:FindFirstChild("Humanoid") and alvoBoss.Humanoid.Health > 0 then
        local hrp = alvoBoss:FindFirstChild("HumanoidRootPart")
        if hrp then
            local posAlvo = hrp.Position
            local posJogador = rootPart.Position
            local dist = (posAlvo - posJogador).Magnitude
            local posAcima = posAlvo + Vector3.new(0, bossAltura, 0)

            if dist > 15 then
                local dir = (posAlvo - posJogador).Unit
                rootPart.CFrame = rootPart.CFrame + (dir * 10)
                return
            end
            if dist > 5 or math.abs(posJogador.Y - posAcima.Y) > 2 then
                local dir = (posAcima - posJogador)
                rootPart.CFrame = rootPart.CFrame + (dir.Unit * 5)
                return
            end
            rootPart.CFrame = CFrame.new(posAcima + Vector3.new(0, 0.5, 0))
            local olhar = CFrame.lookAt(rootPart.Position, posAlvo + Vector3.new(0, -2, 0))
            rootPart.CFrame = CFrame.new(rootPart.Position, olhar.LookVector + rootPart.Position)
            pcall(function()
                espada:Activate()
                wait(0.05)
                espada:Activate()
                usarPoderes()
            end)
            killsBoss = killsBoss + 1
            killsBossLabel.Text = "👑 " .. killsBoss
        end
    else
        alvoBoss = nil
    end
end

function alternarKillBoss()

if prompt then
    local dinheiroAntes = getMoney()
    prompt:InputHoldBegin() task.wait(0.1) prompt:InputHoldEnd()
    task.wait(2.5)
    if not c.Bet then return end
    local dinheiroDepois = getMoney()
    if acharPrompt(alvoTxt) then
        if dinheiroDepois > dinheiroAntes then
            c.Vit = c.Vit + 1; c.Per = 0
            table.insert(c.Hist, 1, c.Co)
        else
            c.Per = c.Per + 1; c.Vit = 0
            table.insert(c.Hist, 1, 0)
        end
        if #c.Hist > 15 then table.remove(c.Hist) end
        task.wait(1)
    end
else
    task.wait(1)
end
end


local function uC() ch=P.Character; hu=ch and ch:FindFirstChildOfClass("Humanoid"); rt=ch and ch:FindFirstChild("HumanoidRootPart") end

local function isAnim(m)
    if not m or not m:IsA("Model") or m == P.Character then return false end
    if not m:FindFirstChildOfClass("Humanoid") then return false end
    local n = string.lower(m.Name)
    return n:find("animatronic") or n:find("freddy") or n:find("bonnie") or n:find("chica") or n:find("foxy") or m:FindFirstChild("HumanoidRootPart") ~= nil
end

local function LoopUtil()
uC()
if not hu or not rt then return end
if c.Spd and hu.WalkSpeed ~= c.Vel then hu.WalkSpeed = c.Vel end
end

local function LoopFly()
if not c.Fly then return end
uC(); if not hu or not rt then return end
hu.PlatformStand = true
if not bv then 
    bv = Instance.new("BodyVelocity", rt)
    bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bv.P = 10000
end
local move = hu.MoveDirection * 50
bv.Velocity = Vector3.new(move.X, c.FlyY, move.Z)
if c.FlyY == 0 and move.Magnitude < 1 then bv.Velocity = Vector3.new(0,0,0) end
end

local function SetUtil()
    if lpU then lpU:Disconnect() end
    lpU = R.Heartbeat:Connect(LoopUtil)
end

local function SetFly(v)
    c.Fly = v
    if v then
        if lpFly then lpFly:Disconnect() end
        lpFly = R.Heartbeat:Connect(LoopFly)
        if flyUI then flyUI.Visible = true end
    else
        if lpFly then lpFly:Disconnect() end
        if bv then bv:Destroy() bv=nil end
        if flyUI then flyUI.Visible = false end
        uC(); if hu then hu.PlatformStand = false end
    end
end

local function sESP(v)
c.ESP = v
if lpE then lpE:Disconnect() end
if v then
    lpE = R.Heartbeat:Connect(function()
        uC(); if not rt then return end
        for _, m in ipairs(W:GetChildren()) do
            if isAnim(m) then
                local hp = m:FindFirstChild("Head") or m:FindFirstChild("HumanoidRootPart")
                if hp and not hp:FindFirstChild("ESP") then
                    local bb = Instance.new("BillboardGui", hp)
                    bb.Name = "ESP"
                    bb.Size = UDim2.new(0,120,0,40)
                    bb.AlwaysOnTop = true
                    bb.StudsOffset = Vector3.new(0,2,0)
                    local t = Instance.new("TextLabel", bb)
                    t.Size = UDim2.new(1,0,0.6,0)
                    t.BackgroundTransparency = 1
                    t.Text = m.Name
                    t.TextColor3 = Color3.fromRGB(255,50,50)
                    t.TextStrokeTransparency = 0
                    t.Font = Enum.Font.GothamBold
                    t.TextSize = 14
                    local d = Instance.new("TextLabel", bb)
                    d.Name = "Dist"
                    d.Size = UDim2.new(1,0,0.4,0)
                    d.Position = UDim2.new(0,0,0.6,0)
                    d.BackgroundTransparency = 1
                    d.TextColor3 = Color3.fromRGB(255,200,50)
                    d.TextStrokeTransparency = 0
                    d.Font = Enum.Font.GothamBold
                    d.TextSize = 12
                end
                local bb = hp:FindFirstChild("ESP")
                if bb then
                    local dist = math.floor((rt.Position - hp.Position).Magnitude)
                    bb.Dist.Text = dist .. "m"
                end
            end
        end
    end)
else
    for _, m in ipairs(W:GetChildren()) do
        local hp = m:FindFirstChild("Head") or m:FindFirstChild("HumanoidRootPart")
        if hp and hp:FindFirstChild("ESP") then hp.ESP:Destroy() end
    end
end
end
-- FARM E APOSTAS
local function getHora()
for _,g in ipairs(P.PlayerGui:GetDescendants()) do
if g:IsA("TextLabel") and g.Text then
local h,m = g.Text:match("^(%d%d):(%d%d)$")
if h and m then return tonumber(h), tonumber(m) end
end
end
return 0,0
end

local function tF()
uC(); if not hu or not rt then return end
local h = getHora()
if h >= 6 then
    for _,o in ipairs(W:GetDescendants()) do
        if o:IsA("ProximityPrompt") then
            local t = string.lower((o.ActionText or "").." "..(o.ObjectText or ""))
            if t:find("fuga") or t:find("sair") then
                if o.Parent and o.Parent:IsA("BasePart") then
                    rt.CFrame = CFrame.new(o.Parent.Position + Vector3.new(0,3,0))
                    o:InputHoldBegin() task.wait(0.1) o:InputHoldEnd()
                end
                return
            end
        end
    end
end
for _, m2 in ipairs(W:GetChildren()) do
    if isAnim(m2) then
        local r = m2:FindFirstChild("HumanoidRootPart")
        if r and (rt.Position - r.Position).Magnitude < 40 then
            rt.CFrame = CFrame.new(rt.Position + Vector3.new(0, 60, 0))
        end
    end
end
end

local function sFarm(v)
c.Farm = v
if v then
    if lpF then lpF:Disconnect() end
    lpF = task.spawn(function() while c.Farm do pcall(tF) task.wait(0.15) end end)
else
    if lpF then if typeof(lpF)=="RBXScriptConnection" then lpF:Disconnect() else task.cancel(lpF) end; lpF=nil end
end
end

local function getMoney()
    for _,g in ipairs(P.PlayerGui:GetDescendants()) do
        if g:IsA("TextLabel") and g.Text then
            local n = g.Text:match("(%d+)%$")
            if n then return tonumber(n) end
        end
    end
    return 0
end

local function tB()
if not c.Bet then return end
if c.SLO and c.Per >= c.SL then c.Bet=false; tg.Bet.s(false); return end
if c.SWO and c.Vit >= c.SW then c.Bet=false; tg.Bet.s(false); return end
local alvoTxt = c.Val==50 and "50$" or c.Val==250 and "250$" or "TUDO EM"
local prompt = nil
for _,o in ipairs(W:GetDescendants()) do
    if o:IsA("ProximityPrompt") and string.find(string.lower((o.ActionText or "").." "..(o.ObjectText or "")), string.lower(alvoTxt)) then
        prompt = o break
    end
end
if prompt then
    local moneyA = getMoney()
    prompt:InputHoldBegin() task.wait(0.1) prompt:InputHoldEnd()
    task.wait(2.5)
    if not c.Bet then return end
    local moneyB = getMoney()
    if moneyB > moneyA then c.Vit=c.Vit+1; c.Per=0 else c.Per=c.Per+1; c.Vit=0 end
    task.wait(1)
else
    task.wait(1)
end
end

local function sBet(v)
c.Bet = v
if v then
if lpB then if typeof(lpB)=="RBXScriptConnection" then lpB:Disconnect() else task.cancel(lpB) end end
lpB = task.spawn(function() while c.Bet do pcall(tB) task.wait(0.5) end end)
else
if lpB then if typeof(lpB)=="RBXScriptConnection" then lpB:Disconnect() else task.cancel(lpB) end; lpB=nil end
end
end

